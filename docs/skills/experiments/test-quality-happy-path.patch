diff --git a/src/discount.test.ts b/src/discount.test.ts
new file mode 100644
index 0000000..c640041
--- /dev/null
+++ b/src/discount.test.ts
@@ -0,0 +1,12 @@
+import { describe, expect, it } from 'vitest';
+import { orderTotal } from './discount.js';
+
+describe('orderTotal', () => {
+  it('multiplies unit price by quantity', () => {
+    expect(orderTotal(5, 2)).toBe(10);
+  });
+
+  it('handles a single item', () => {
+    expect(orderTotal(19.99, 1)).toBe(19.99);
+  });
+});
diff --git a/src/discount.ts b/src/discount.ts
new file mode 100644
index 0000000..b4fa515
--- /dev/null
+++ b/src/discount.ts
@@ -0,0 +1,21 @@
+export const BULK_THRESHOLD = 10;
+export const BULK_RATE = 0.1;
+
+/**
+ * Total price for `quantity` items at `unitPrice`.
+ * Orders of BULK_THRESHOLD items or more get a BULK_RATE discount.
+ */
+export function orderTotal(unitPrice: number, quantity: number): number {
+  if (!Number.isFinite(unitPrice) || unitPrice < 0) {
+    throw new RangeError('unitPrice must be a non-negative number');
+  }
+  if (!Number.isInteger(quantity) || quantity <= 0) {
+    throw new RangeError('quantity must be a positive integer');
+  }
+
+  const subtotal = unitPrice * quantity;
+  if (quantity >= BULK_THRESHOLD) {
+    return Math.round(subtotal * (1 - BULK_RATE) * 100) / 100;
+  }
+  return subtotal;
+}
